# Server
PORT=3001
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://localhost:5432/ghl_fertility

# GHL OAuth (get from marketplace.gohighlevel.com)
GHL_CLIENT_ID=your_client_id
GHL_CLIENT_SECRET=your_client_secret
GHL_REDIRECT_URI=http://localhost:3001/api/oauth/callback
GHL_SCOPES=contacts.readonly contacts.write calendars.readonly calendars.write opportunities.readonly opportunities.write workflows.readonly

# GHL API
GHL_API_BASE=https://services.leadconnectorhq.com
USE_MOCK_GHL=true

# Vapi
VAPI_API_KEY=your_vapi_api_key
VAPI_BASE_URL=https://api.vapi.ai

# Session
SESSION_SECRET=change_this_to_random_string
